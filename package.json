{
  "name": "art-house",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "lsof -ti:3000,3001 | xargs -r kill -9 2>/dev/null; rm -rf .next node_modules/.cache && next dev",
    "build": "next build",
    "build:safe": "lsof -ti:3000,3001 | xargs -r kill -9 2>/dev/null; rm -rf .next && next build",
    "start": "next start",
    "lint": "next lint",
    "check:pre-deploy": "python3 scripts/check-pre-deploy.py --skip-prod-only",
    "check:pre-deploy:prod": "python3 scripts/check-pre-deploy.py https://arthouse.am https://arthouse.am --workers 12",
    "deploy:local": "npm run build && pm2 start ecosystem.config.js --env local",
    "deploy:dev": "npm run build && pm2 start ecosystem.config.js --env local",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --env local"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fancyapps/ui": "^5.0.36",
    "@googlemaps/js-api-loader": "^1.16.8",
    "@mui/material": "^5.15.15",
    "@popmotion/popcorn": "^0.4.4",
    "@portabletext/react": "^3.0.15",
    "@reduxjs/toolkit": "^2.2.3",
    "@sanity/dashboard": "^3.1.6",
    "@sanity/icons": "^2.11.2",
    "@sanity/image-url": "^1.0.2",
    "@sanity/vision": "^3.32.0",
    "axios": "^1.6.8",
    "embla-carousel-autoplay": "^8.0.0",
    "embla-carousel-react": "^8.0.0",
    "framer-motion": "^11.0.18",
    "next": "14.1.0",
    "next-connect": "^1.0.0",
    "next-intl": "3.5.3",
    "next-sanity": "^7.1.4",
    "nextjs-current-url": "^1.0.1",
    "nodemailer": "^7.0.5",
    "react-facebook": "^9.0.12",
    "react-icons": "^5.0.1",
    "react-input-mask": "^2.0.4",
    "react-loader-spinner": "^6.1.6",
    "react-multi-carousel": "^2.8.5",
    "react-player": "^2.15.1",
    "react-redux": "^9.1.0",
    "react-scroll": "^1.9.0",
    "react-slick": "^0.30.2",
    "react-stacked-center-carousel": "^1.0.14",
    "react-type-animation": "^3.2.0",
    "sanity": "^3.32.0",
    "schema-dts": "^1.1.2",
    "sharp": "^0.35.2",
    "slick-carousel": "^1.8.1",
    "styled-components": "^6.1.8",
    "swiper": "^11.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-input-mask": "^3.0.5",
    "@types/react-scroll": "^1.8.10",
    "@types/react-slick": "^0.23.13",
    "@types/video-react": "^0.15.6",
    "eslint": "^8",
    "eslint-config-next": "14.1.3",
    "sass": "^1.71.1",
    "typescript": "^5"
  }
}
