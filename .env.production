# Public production values. Next.js loads this during `next build`, including on Vercel.
# A Vercel project env var with the same name overrides the value here.
# Secrets (mail password, revalidate secret) stay in the Vercel dashboard only.

NEXT_PUBLIC_SANITY_PROJECT_ID=8goj5g2g
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-02

NEXT_PUBLIC_DOMAIN=https://arthouse.am
NEXT_PUBLIC_SITE_NAME=Art House
