# Public production origin. Next.js loads this during `next build`, including on Vercel.
# Canonical tags, robots.txt, and the sitemap use it when the Vercel project
# does not set NEXT_PUBLIC_DOMAIN. A Vercel env var with the same name overrides this.
NEXT_PUBLIC_DOMAIN=https://arthouse.am
NEXT_PUBLIC_SITE_NAME=Art House
